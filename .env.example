# Copiar a `.env` en la raíz del repo. Expo carga automáticamente las
# variables con prefijo EXPO_PUBLIC_ y las embebe en el bundle (no son
# secretas: no pongas acá nada que no deba terminar en el binario de la app).

# ── API ─────────────────────────────────────────────────────────
# Por defecto apunta a producción (misma API que ya usa la web en Vercel).
EXPO_PUBLIC_API_URL=https://trip-planner-eight-pi.vercel.app

# Para debuggear contra el backend corriendo en tu máquina (`npm run dev` en
# el repo C:\Trip-Planner), usá la IP de tu LAN, no "localhost": un
# dispositivo físico o emulador no resuelve el localhost de tu PC.
#   Windows: ipconfig  -> "Dirección IPv4" de tu adaptador de red
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# ── Google Sign-In (HU-5.2) ────────────────────────────────────────
# Reusa el Client ID *Web* que ya existe para el backend/frontend web
# (mismo valor que GOOGLE_CLIENT_ID_TP / VITE_GOOGLE_CLIENT_ID_TP en el repo
# C:\Trip-Planner). Es el que determina el "audience" del ID token que el
# backend valida — por eso NO se crea un client ID Web nuevo para mobile.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Client ID de iOS nuevo (tipo "iOS" en Google Cloud Console, con el Bundle ID
# com.dirugadr.tripplanner). Distinto al Web Client ID de arriba.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com

# No hace falta ninguna variable acá para el Client ID de Android: se
# registra en Google Cloud Console con el package name (com.dirugadr.tripplanner)
# y el SHA-1 del certificado de firma, pero el SDK nativo no lo necesita en
# runtime (usa el Web Client ID como audience).
